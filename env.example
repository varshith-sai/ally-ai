# RocketRide connection — configured via the VS Code extension
ROCKETRIDE_URI=http://localhost:5565
ROCKETRIDE_APIKEY=your-rocketride-api-key-here

# Anthropic API key — used by llm_anthropic in all three pipelines
# Get yours at https://console.anthropic.com/
ROCKETRIDE_ANTHROPIC_KEY=sk-ant-...

# Butterbase REST API base URL — fixed for this project, do not change
ROCKETRIDE_BUTTERBASE_API_URL=https://api.butterbase.ai/v1/app_xeg6ezge73up

# Butterbase — used directly by the WhatsApp handler
BUTTERBASE_API_URL=https://api.butterbase.ai/v1/app_xeg6ezge73up
BUTTERBASE_SERVICE_KEY=bb_sk_...   # your service key (bypasses RLS — keep secret)

# Spectrum (Photon) — sign up at app.photon.codes, create a project, enable WhatsApp
# https://photon.codes/pricing
PROJECT_ID=your-spectrum-project-id
PROJECT_SECRET=your-spectrum-project-secret

# WhatsApp Business API — from Meta Developer Console (developers.facebook.com)
# Required for: (a) weekly-progress-trigger cron to send nudges
#               (b) self-hosted WhatsApp if not using Spectrum Cloud managed credentials
# If PROJECT_ID/PROJECT_SECRET are set and Spectrum Cloud manages WhatsApp, these are only needed by the cron.
WA_ACCESS_TOKEN=your-meta-whatsapp-access-token
WA_PHONE_NUMBER_ID=your-meta-phone-number-id
